# Secrets for the platform engineer root. Copy to terraform.tfvars, which
# git ignores.
#
# These are shared by the team. If the demo is already built, copy the
# team's terraform.tfvars and do not write your own.
#
# Everything that is not secret is in lab.auto.tfvars, in git.

# Password of platform-admin: the org_admin_password of
# terraform/cloud-admin.
vcfa_password = "CHANGE-ME"

# Password hash for the Private AI Services user "admin". Make one with:
#   openssl passwd -6
# The hash is salted. A new hash of the same password is a different
# value, and Terraform would rewrite the Secret. Copy the team's hash.
pais_admin_password_hash = "$6$CHANGE-ME"

# The music store's secrets, written to Secret Store (decision 38). In the
# workflow they are the GitHub secrets MUSIC_STORE_DB_PASSWORD and
# MUSIC_STORE_CHAT_API_KEY. Copy the team's values: a new database
# password is set on the database at the next sync, and the shop's pods
# need a restart to pick it up.
music_store_db_password  = "CHANGE-ME"
music_store_chat_api_key = "CHANGE-ME"

# The other secret this root needs is a file, not a variable:
#   .secrets/gitops-deploy-key
# lab.auto.tfvars points at it. Copy the team's file there.
