{
  "uid": "goad-node-disk-latency",
  "title": "GOAD: node disk latency",
  "tags": [
    "goad",
    "storage",
    "disk"
  ],
  "description": "Write IOPS, latency and queue per node and disk of a VKS cluster, next to the music store's pods.",
  "schemaVersion": 42,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "How to read this board",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "Each line is one disk on one node: `host.name` is the node's metrics agent, `device` is the disk. `sda` is the node's OS disk; `sdb`, `sdc` and up are PVCs. A disk with high latency while its IOPS stay flat is held at a limit, not busy. The built-in I/O board adds every node's disks together, so one slow disk does not show there."
      }
    },
    {
      "id": 2,
      "type": "row",
      "title": "The shop's pods",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "panels": []
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Pod CPU (cores), namespace music-store",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "max by (k8s.pod.name) (k8s.pod.cpu.usage{k8s.namespace.name=\"music-store\"})",
          "legendFormat": "{{k8s.pod.name}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Pod memory working set, namespace music-store",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "max by (k8s.pod.name) (k8s.pod.memory.working_set{k8s.namespace.name=\"music-store\"})",
          "legendFormat": "{{k8s.pod.name}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Slowest disk, write latency",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 20
              },
              {
                "color": "red",
                "value": 30
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "max(1000 * max by (host.name, device) (rate(system.disk.operation_time{direction=\"write\", device=~\"sd[a-z]+\"}[2m])) / max by (host.name, device) (rate(system.disk.operations{direction=\"write\", device=~\"sd[a-z]+\"}[2m]) > 0))",
          "legendFormat": "slowest disk"
        }
      ]
    },
    {
      "id": 6,
      "type": "row",
      "title": "Disks, per node",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Write latency per disk (ms)",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 30
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "1000 * max by (host.name, device) (rate(system.disk.operation_time{direction=\"write\", device=~\"sd[a-z]+\"}[2m])) / max by (host.name, device) (rate(system.disk.operations{direction=\"write\", device=~\"sd[a-z]+\"}[2m]) > 0)",
          "legendFormat": "{{host.name}} {{device}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Write IOPS per disk",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {
          "unit": "iops",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "max by (host.name, device) (rate(system.disk.operations{direction=\"write\", device=~\"sd[a-z]+\"}[2m]))",
          "legendFormat": "{{host.name}} {{device}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Queued I/O per disk",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "max by (host.name, device) (system.disk.pending_operations{device=~\"sd[a-z]+\"})",
          "legendFormat": "{{host.name}} {{device}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Disk busy time (fraction)",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 22
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "max by (host.name, device) (rate(system.disk.io_time{device=~\"sd[a-z]+\"}[2m]))",
          "legendFormat": "{{host.name}} {{device}}"
        }
      ]
    }
  ]
}
