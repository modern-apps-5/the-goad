# Copy to terraform.tfvars and fill in. terraform.tfvars holds secrets
# and is ignored by git.

# Password of the provider administrator (admin) in the System org.
vcfa_password      = "CHANGE-ME"
org_admin_password = "CHANGE-ME"

vcfa_url = "https://CHANGE-ME"
# allow_unverified_ssl = true

region_name           = "CHANGE-ME"
distributed_vlan_connection_name = "CHANGE-ME"
vna_cluster_name = "CHANGE-ME"

zone_allocations = {
  "CHANGE-ME" = {
    cpu_limit_mhz    = 100000
    memory_limit_mib = 262144
  }
}

# Add the GPU VM class when a GPU is allocated.
vm_class_names = [
  "best-effort-small",
  "best-effort-medium",
  "best-effort-large",
  "best-effort-xlarge",
]

storage_policy_limits_mib = {
  "vSAN Default Storage Policy" = 1048576
}

# oidc = {
#   wellknown_endpoint = "https://CHANGE-ME/.well-known/openid-configuration"
#   client_id          = "CHANGE-ME"
# }
# oidc_client_secret = "CHANGE-ME"
