# Secrets for the cloud admin root. Copy to terraform.tfvars, which git
# ignores.
#
# These are shared by the team. If the demo is already built, copy the
# team's terraform.tfvars and do not write your own: a different
# org_admin_password changes the password everyone logs in with.
#
# Everything that is not secret is in lab.auto.tfvars, in git.

# Password of the provider administrator (admin) in the System org.
vcfa_password = "CHANGE-ME"

# Password of the org's first administrator, platform-admin. Terraform
# sets it.
org_admin_password = "CHANGE-ME"

# Only when oidc is set in lab.auto.tfvars.
# oidc_client_secret = "CHANGE-ME"
