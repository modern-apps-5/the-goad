{
  "uid": "captain-demo-ready",
  "title": "Can I demo right now?",
  "description": "Every tile green means yes. True only when Ollama answers, qwen2.5:32b is loaded, nothing is in flight, the queue is empty, the store is HTTP 200, Zammad is HTTP 200, and AgentMinder discovery is HTTP 200.",
  "tags": [
    "captain"
  ],
  "editable": true,
  "graphTooltip": 0,
  "refresh": "30s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timezone": "utc",
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "",
      "description": "Green is OK. Red says what is wrong. A check that could not be read is red. Ready requires Ollama, qwen2.5:32b loaded, nothing in flight, an empty queue, store HTTP 200, Zammad HTTP 200, and AgentMinder discovery HTTP 200.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "company-watch"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 26
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "company-watch"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "/api/captain/demo-ready",
          "url_options": {
            "method": "GET",
            "data": ""
