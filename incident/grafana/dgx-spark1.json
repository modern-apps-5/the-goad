  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "editable": true,
  "links": [],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "description": "Ollama on goad-qwen, model qwen2.5:32b. Demo-ready, in flight, queue, request latency, and the loaded model. GPU panels say there is no GPU.",
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "How to read this board",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "Goad has no GPU. The GPU panels on this board say no GPU. They are not a zero from a GPU exporter. Demo-ready, in flight, queue, latency, and the loaded model read the Ollama VM goad-qwen, model qwen2.5:32b. Demo-ready means Ollama answered, qwen2.5:32b is loaded, nothing is in flight, and the queue is empty."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Demo-ready",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "goad-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "not ready",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "demo-ready",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ollama_demo_ready",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "goad-prometheus"
          }
        }
      ],
      "description": "Ollama on goad-qwen. 1 only when qwen2.5:32b is loaded, nothing is in flight, and the queue is empty."
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Why",
