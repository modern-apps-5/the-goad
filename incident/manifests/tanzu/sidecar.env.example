# Copy outside git. One file per agent. chmod 600.
# AGENTMINDER_SIDECAR_TOKEN is the loopback token between the app and
# the sidecar. The sidecar mints the AgentMinder bearer from the
# client id and secret below. Never commit either value.
AGENTMINDER_IDSP_URL=https://agentminder.example/default
AGENTMINDER_SIDECAR_TOKEN=
AGENTMINDER_SIDECAR_AGENT_CLIENT_ID=
AGENTMINDER_SIDECAR_AGENT_CLIENT_SECRET=
AGENTMINDER_SIDECAR_RESOURCE_0_NAME=k8s
AGENTMINDER_SIDECAR_RESOURCE_0_URL=https://agentminder.example/default/aigateway/v1/mcp/CHANGEME
AGENTMINDER_SIDECAR_RESOURCE_0_AUDIENCE=https://agentminder.example/default/aigateway/v1/mcp/CHANGEME
AGENTMINDER_CA_BUNDLE=/home/vcap/app/sidecar/lab-ca.pem
