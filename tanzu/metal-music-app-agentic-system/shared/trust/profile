# The agent HTTP client uses SSL_CERT_FILE when it is set.
# The model's certificate, at pais.goad.gpu.set.lab, is from the GOAD CA,
# which is not in the system bundle: add it.
base="${SSL_CERT_FILE:-/etc/ssl/certs/ca-certificates.crt}"
if [ -r "$base" ] && [ -r /home/vcap/app/goad-ca.pem ]; then
  cat "$base" /home/vcap/app/goad-ca.pem > /home/vcap/app/trust-bundle.pem
  export SSL_CERT_FILE=/home/vcap/app/trust-bundle.pem
  echo 'trust: GOAD CA added' >&2
else
  echo 'trust: GOAD CA was not added' >&2
fi

# The diagnostic agents' AgentMinder client, from the bound am-* service.
# Only they have the sidecar, so only they have the file.
if [ -r /home/vcap/app/sidecar/agentminder-env.sh ]; then
  . /home/vcap/app/sidecar/agentminder-env.sh || echo 'agentminder-env: no client' >&2
fi
