# Snapshot of namespace music-store taken 2026-10-22 before the storefront
# cutover. Not applied. Secret values are removed. Argo did not own the
# users-service or postgres-service Endpoints; they are here as a record
# of the addresses the shop was using.
---
{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "annotations": {
      "argocd.argoproj.io/installation-id": "platform-9pq9n-instance",
      "argocd.argoproj.io/tracking-id": "music-store-dev-app:apps/Deployment:music-store/cart-service"
    },
    "name": "cart-service",
    "namespace": "music-store"
  },
  "spec": {
    "progressDeadlineSeconds": 600,
    "replicas": 1,
    "revisionHistoryLimit": 10,
    "selector": {
      "matchLabels": {
        "app": "cart-service"
      }
    },
    "strategy": {
      "rollingUpdate": {
        "maxSurge": "25%",
        "maxUnavailable": "25%"
      },
      "type": "RollingUpdate"
    },
    "template": {
      "metadata": {
        "annotations": {
          "date": "2024-01-$(date +%d)",
          "kubernetes.io/change-cause": "Fixed cart clearing after purchase, updated success message",
          "timestamp": "$(date +%s)"
        },
        "labels": {
          "app": "cart-service",
          "app-name": "music-store",
          "env": "prod",
          "service-name": "cart"
        }
      },
      "spec": {
        "containers": [
          {
            "env": [
              {
                "name": "STORE_SERVICE_URL",
                "value": "http://music-store-1-service:5000"
              },
              {
                "name": "ORDER_SERVICE_URL",
                "value": "http://order-service:5001"
              },
              {
                "name": "CART_DB_PATH",
                "value": "/app/data/cart.db"
              }
            ],
            "image": "ghcr.io/niranec77/metal-music-store-cart:1.0.63",
            "imagePullPolicy": "Always",
            "name": "cart-service",
            "ports": [
              {
                "containerPort": 5002,
                "protocol": "TCP"
              }
            ],
            "resources": {},
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              },
              "runAsGroup": 1000,
              "runAsNonRoot": true,
              "runAsUser": 1000,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "terminationMessagePath": "/dev/termination-log",
            "terminationMessagePolicy": "File",
            "volumeMounts": [
              {
                "mountPath": "/app/data",
                "name": "cart-data"
              }
            ]
          }
        ],
        "dnsPolicy": "ClusterFirst",
        "restartPolicy": "Always",
        "schedulerName": "default-scheduler",
        "securityContext": {
          "fsGroup": 1000,
          "runAsGroup": 1000,
          "runAsNonRoot": true,
          "runAsUser": 1000,
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        },
        "terminationGracePeriodSeconds": 30,
        "volumes": [
          {
            "name": "cart-data",
            "persistentVolumeClaim": {
              "claimName": "cart-pvc"
            }
          }
        ]
      }
    }
  }
}
